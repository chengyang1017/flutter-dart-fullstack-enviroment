# Flutter Playground 应用配置

# Web 应用端口
APP_PORT=8080

# Flutter Runner API 端口
RUNNER_PORT=8787

# Flutter 版本 (默认 3.24.1)
FLUTTER_VERSION=3.24.1

# Runner 执行模式: local 或 docker
RUNNER_MODE=local

# Cloud Workspace storage. Configure the URL to enable real account login.
# Cloud storage is authoritative and Hive/IndexedDB is a per-account cache.
WORKSPACE_STORAGE_API_URL=

# Optional development auto-login bearer token. Leave empty for the real
# register/login screen. Normal users never configure this value themselves.
WORKSPACE_ACCESS_TOKEN=

# 可选: 用于生产环境的域名
# APP_DOMAIN=flutter-playground.example.com
# RUNNER_DOMAIN=runner.example.com

# 可选: 日志级别 debug, info, warn, error
# LOG_LEVEL=info
