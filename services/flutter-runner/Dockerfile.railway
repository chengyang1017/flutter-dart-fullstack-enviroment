FROM dart:stable AS build

WORKDIR /src

COPY pubspec.yaml ./
RUN dart pub get

COPY bin ./bin
COPY lib ./lib

RUN mkdir -p /out \
    && dart compile exe bin/server.dart -o /out/flutter-runner-server


FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tar \
    && rm -rf /var/lib/apt/lists/*

ENV FLYCTL_INSTALL=/opt/fly
RUN curl -fsSL https://fly.io/install.sh | sh \
    && test -x /opt/fly/bin/flyctl

ENV PATH=/opt/fly/bin:${PATH}

RUN groupadd --system runner \
    && useradd \
        --system \
        --gid runner \
        --create-home \
        --home-dir /home/runner \
        --shell /usr/sbin/nologin \
        runner \
    && mkdir -p /workspace \
    && chown -R runner:runner /workspace /home/runner

COPY --from=build --chown=runner:runner \
    /out/flutter-runner-server \
    /usr/local/bin/flutter-runner-server

USER runner

ENV HOME=/home/runner
ENV RUNNER_HOST=0.0.0.0
ENV RUNNER_EXECUTION_MODE=fly
ENV FLYCTL_EXECUTABLE=/opt/fly/bin/flyctl
ENV TAR_EXECUTABLE=/usr/bin/tar

EXPOSE 8787

CMD ["/usr/local/bin/flutter-runner-server"]
